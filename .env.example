# Placeholders only. Copy to .env and fill in real values locally.
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=replace-me
JWT_SIGNING_KEY=replace-me
# Booking QR tokens: its own key (>= 50 chars in prod). Rotate by moving the old value to
# QR_SIGNING_KEY_FALLBACKS (comma separated) for one token lifetime.
QR_SIGNING_KEY=replace-me
QR_SIGNING_KEY_FALLBACKS=
DATABASE_URL=postgis://habi:replace-me@localhost:5432/habi
REDIS_URL=redis://localhost:6379/0
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
POSTGRES_DB=habi
POSTGRES_USER=habi
POSTGRES_PASSWORD=replace-me
OSRM_URL=http://localhost:5000
# Routing service area: lat_min,lat_max,lng_min,lng_max (points outside get 400 route_too_far)
ROUTING_BBOX=36.5,46.0,55.5,74.5
# Longest straight-line distance (km) between route endpoints
ROUTING_MAX_STRAIGHT_KM=2000
# Above this straight-line distance (km) OSRM is asked for a simplified geometry
ROUTING_FULL_OVERVIEW_MAX_KM=100
TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_BOT_USERNAME=replace-me
TELEGRAM_WEBHOOK_SECRET=replace-me
# Number of trusted reverse proxies (X-Forwarded-For) for IP throttling; prod default 1
NUM_PROXIES=1
# Used only by `manage.py create_superadmin` (otherwise it prompts); min 12 chars
HABI_SUPERADMIN_PASSWORD=replace-me
# --- Payments (Step 8a). All mandatory in production; the keys are SECRET: never commit real ones.
# Provider used when POST /bookings omits payment_provider: payme | click
PAYMENTS_DEFAULT_PROVIDER=payme
# Payme Business web cash register: id + key (>= 32 chars). The Basic auth login is fixed (Paycom).
PAYME_MERCHANT_ID=replace-me
PAYME_KEY=replace-me
# Click: service/merchant ids, merchant_user_id (Merchant API, refunds) and SECRET_KEY
CLICK_SERVICE_ID=replace-me
CLICK_MERCHANT_ID=replace-me
CLICK_MERCHANT_USER_ID=replace-me
CLICK_SECRET_KEY=replace-me
# Provider source IPs allowed to call the webhooks (comma separated, CIDR ok). Empty = no check;
# set it in production. Payme: 185.234.113.1-15. Click: ask CLICK support.
PAYMENTS_PROVIDER_IPS=
# Per provider (override the shared list). Production defaults PAYMENTS_PAYME_IPS to Payme's
# published 185.234.113.1-15 and refuses an empty Payme list; ask CLICK for theirs.
# PAYMENTS_PAYME_IPS=185.234.113.1,185.234.113.2
# PAYMENTS_CLICK_IPS=
# UNCONFIRMED Click behaviour, off by default (see docs/ARCHITECTURE.md 8.4): Merchant API error
# codes meaning "already reversed", and the status check before re-sending a reversal.
CLICK_REVERSAL_DONE_CODES=
CLICK_STATUS_CHECK=false
CLICK_STATUS_REVERSED_VALUES=
# Where the provider sends the driver after paying (deep link or https URL), optional
PAYMENTS_RETURN_URL=
# Provider sandbox checkout (dev/test only; production refuses to start with it on)
PAYMENTS_SANDBOX=false
# --- Operator gate (Step 9a). Optional tuning, no secrets; the values shown are the defaults.
# BOOKING_CHECKIN_EARLY_MINUTES=30      earliest check-in before the booked start
# BOOKING_QR_EXIT_MINUTES=720           life of the exit QR (overstaying cars must be able to leave)
# BOOKING_WALKIN_MAX_HOURS=12           longest walk-in period (cut short by the next booking)
# BOOKING_WALKIN_MIN_GAP_MINUTES=15     no walk-in if a booking starts within this
# BOOKING_OVERSTAY_REASSIGN_MINUTES=15  move the waiting booking off an overstaying car (0 = off)
# OPERATOR_SCAN_FAIL_LIMIT=10           suspicious failed scans before the operator is locked out
# OPERATOR_SCAN_FAIL_WINDOW_SECONDS=300
# OPERATOR_MAP_HORIZON_HOURS=24         "next booking" horizon on the slot map
# --- Realtime & notifications (Step 10a)
# Expo Push access token: optional (only needed when "enhanced push security" is on); SECRET.
EXPO_ACCESS_TOKEN=
# Public https base URL of the universal links (https://<host>/b/<booking id>) used in Telegram
# buttons. MANDATORY in production and must be https; dev falls back to https://habi.test.
HABI_PUBLIC_URL=https://habi.uz
# Redis roles: broker + results use REDIS_URL (db 0). The others default to the SAME server with
# db 1 (channel layer) / 2 (cache) / 3 (application state: tickets, registries, debounce).
# Broker, channel layer and state need a `noeviction` server; the cache may be allkeys-lru, so in
# production point CACHE_REDIS_URL at its own instance. Redis >= 6.2 (GETDEL).
# CHANNEL_REDIS_URL=redis://localhost:6379/1
# CACHE_REDIS_URL=redis://localhost:6379/2
# STATE_REDIS_URL=redis://localhost:6379/3
# Production: reuse PostgreSQL connections for this many seconds (0 = one per request)
# DB_CONN_MAX_AGE=60
# WebSocket tuning, no secrets; the values shown are the defaults:
# WS_MAX_GROUPS_PER_CONNECTION=50  WS_MAX_MESSAGE_BYTES=4096  WS_MESSAGES_PER_SECOND=10
# WS_MAX_CONNECTIONS_PER_USER=5  WS_HEARTBEAT_SECONDS=30  WS_IDLE_TIMEOUT_SECONDS=90
# WS_MAX_AGE_SECONDS=43200  WS_NEGATIVE_CACHE_SECONDS=30  WS_DEBOUNCE_MILLISECONDS=200  NOTIFICATION_LOG_RETENTION_DAYS=180  PUSH_TOKEN_MAX_AGE_DAYS=90
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
EXPO_PUBLIC_WS_URL=ws://localhost:8000/ws
EXPO_PUBLIC_TELEGRAM_BOT=replace-me
# EAS project id (`eas init`); needed for Expo push tokens. Leave empty to build without push.
EXPO_PUBLIC_EAS_PROJECT_ID=
# Android Google Maps SDK key (restrict it to the app package + SHA-1 in Google Cloud)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=replace-me
# Dev/preview builds only: lets the payment WebView open the test.paycom.uz sandbox host.
# A production build with this set to true FAILS on purpose (see mobile/config/paymentSandbox.js).
EXPO_PUBLIC_PAYMENT_SANDBOX=false
VITE_API_URL=http://localhost:8000/api/v1
# --- Sentry (backend): empty DSN = disabled. Release = deployed image tag / git SHA.
# Bodies, cookies, QR tokens, WS tickets, bot/payment keys are scrubbed (backend/config/sentry.py).
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
# Mobile / admin Sentry DSNs are RESERVED names, not read yet (no Sentry SDK is installed in
# mobile/ or admin/). DSNs are public identifiers, but never commit real ones; set them in EAS
# env vars (EXPO_PUBLIC_SENTRY_DSN) and the admin build args (VITE_SENTRY_DSN) when wired.
# Admin build (public values baked into the bundle; infra/nginx/Dockerfile):
VITE_TELEGRAM_BOT_USERNAME=replace-me
# VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
