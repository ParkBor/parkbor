# API base URL (default: /api/v1, proxied to the backend by `vite dev` and by nginx in production)
VITE_API_URL=/api/v1

# Bot username WITHOUT the leading @ (e.g. HabiParkingBot). Required: the Telegram Login Widget
# is configured with it. The bot's domain must be registered with BotFather: /setdomain.
# Values here are bundled into the public JS; never put secrets in VITE_* variables.
VITE_TELEGRAM_BOT_USERNAME=

# Map tile URL template for the parking map (default: the public OpenStreetMap server, which is
# for light use only). If you change it, the host must also be allowed in the CSP img-src.
# VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Content-Security-Policy and the other headers are set by nginx; the full list and the reasons
# are in docs/ARCHITECTURE.md, section 14.3 "Admin veb xavfsizligi". In short, the widget needs:
#   script-src  'self' https://telegram.org 'unsafe-eval'
#       ('unsafe-eval' because telegram-widget.js runs data-onauth through eval(); checked in the
#        script source. The newer Telegram.Login.auth API returns an OIDC id_token, which the
#        backend's HMAC check does not accept, so it is not used yet.)
#   frame-src   https://oauth.telegram.org
#   connect-src 'self'                  (the API is same-origin behind nginx)
# Not yet verified in a real browser against the real Telegram widget.
