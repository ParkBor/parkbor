{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "/backend/**"
    ]
  },
  "deploy": {
    "startCommand": "exec celery -A config beat -l info --pidfile /tmp/celerybeat.pid -s /tmp/celerybeat-schedule",
    "restartPolicyType": "ALWAYS",
    "numReplicas": 1,
    "overlapSeconds": "0",
    "drainingSeconds": "10"
  }
}
