# api service only (on top of backend.env.example). PORT is injected by Railway; do not set it.
WEB_CONCURRENCY=2
# uvicorn trusts X-Forwarded-* from any peer: the service is reachable only through Railway's edge
# (public domain) and the project's private network.
FORWARDED_ALLOW_IPS=*
# Only if your environment is IPv6-only (created before 2025-10-16): UVICORN_HOST=::
# DB_CONN_MAX_AGE=60
# Needed once, for `python manage.py create_superadmin` (remove it afterwards):
# HABI_SUPERADMIN_PASSWORD=<generated, >= 12 chars>
# Railway platform setting (SIGTERM -> SIGKILL grace for the old deployment)
RAILWAY_DEPLOYMENT_DRAINING_SECONDS=30
