# Variables shared by the five backend services: api, worker-default, worker-realtime,
# worker-notify, beat (docs/RAILWAY.md, step 4). Put them in Project Settings -> Shared Variables
# and attach them to each service, or paste this block into each service's "RAW Editor".
# NAMES AND REFERENCES ONLY: never commit real values. Generate secrets with
#   python deploy/railway/gen-secrets.py [--staging]
# ${{ ... }} are Railway reference variables; service names below are the names you give the
# services in the dashboard (change them here if you name them differently).

# ---- Django / secrets (config.settings.prod refuses to boot without them)
SECRET_KEY=<generated>
JWT_SIGNING_KEY=<generated>
QR_SIGNING_KEY=<generated, >= 50 chars>
ALLOWED_HOSTS=api.parkbor.uz,healthcheck.railway.app
CORS_ALLOWED_ORIGINS=https://crm.parkbor.uz
HABI_PUBLIC_URL=https://parkbor.uz
# Number of trusted hops at the right end of X-Forwarded-For (payment IP allowlist + throttling).
# Railway's edge chain is not documented: see docs/RAILWAY.md "NUM_PROXIES" before going live.
NUM_PROXIES=1

# ---- PostgreSQL + PostGIS (the postgis:// scheme is mandatory)
DATABASE_URL=postgis://${{postgis.POSTGRES_USER}}:${{postgis.POSTGRES_PASSWORD}}@${{postgis.RAILWAY_PRIVATE_DOMAIN}}:5432/${{postgis.POSTGRES_DB}}

# ---- Redis: broker (db 0), Channels (db 1), application state (db 3) on the noeviction server
REDIS_URL=redis://:${{redis.REDIS_PASSWORD}}@${{redis.RAILWAY_PRIVATE_DOMAIN}}:6379/0
CHANNEL_REDIS_URL=redis://:${{redis.REDIS_PASSWORD}}@${{redis.RAILWAY_PRIVATE_DOMAIN}}:6379/1
STATE_REDIS_URL=redis://:${{redis.REDIS_PASSWORD}}@${{redis.RAILWAY_PRIVATE_DOMAIN}}:6379/3
# Cache + throttling: own allkeys-lru server. Leave UNSET until the redis-cache service exists
# (the app then uses db 2 of the noeviction server; acceptable for a first deploy).
# CACHE_REDIS_URL=redis://:${{redis-cache.REDIS_PASSWORD}}@${{redis-cache.RAILWAY_PRIVATE_DOMAIN}}:6379/0

# ---- Routing: leave unset to run WITHOUT OSRM (routes degrade to a straight-line estimate).
# With the optional osrm service:  OSRM_URL=http://${{osrm.RAILWAY_PRIVATE_DOMAIN}}:5000
# OSRM_URL=

# ---- Telegram
TELEGRAM_BOT_TOKEN=<from BotFather>
TELEGRAM_BOT_USERNAME=<bot username without @>
TELEGRAM_WEBHOOK_SECRET=<generated>

# ---- Payments. Production checks require ALL of these to be non-placeholder and
# PAYMENTS_SANDBOX to be false (sandbox mode is refused at boot, by design).
# Staging before the merchant contracts: use `gen-secrets.py --staging` random placeholders.
PAYME_MERCHANT_ID=<Payme Business | staging placeholder>
PAYME_KEY=<>= 32 chars | staging placeholder>
CLICK_SERVICE_ID=<Click | staging placeholder>
CLICK_MERCHANT_ID=<Click | staging placeholder>
CLICK_MERCHANT_USER_ID=<Click | staging placeholder>
CLICK_SECRET_KEY=<>= 12 chars | staging placeholder>
PAYMENTS_SANDBOX=false
PAYMENTS_DEFAULT_PROVIDER=payme
# PAYMENTS_CLICK_IPS=<from CLICK support>
# PAYMENTS_RETURN_URL=

# ---- Optional
EXPO_ACCESS_TOKEN=
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE: Railway exposes RAILWAY_GIT_COMMIT_SHA; reference it if Sentry is enabled
# SENTRY_RELEASE=${{RAILWAY_GIT_COMMIT_SHA}}
SENTRY_TRACES_SAMPLE_RATE=0
