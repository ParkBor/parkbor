# crm service. These are BUILD-TIME values (public, they end up in the JS bundle). Changing one
# requires a redeploy (rebuild) of the crm service. PORT is injected by Railway.
VITE_API_URL=https://api.parkbor.uz/api/v1
VITE_TELEGRAM_BOT_USERNAME=<bot username without @>
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Runtime value for the CSP connect-src: the ORIGIN of VITE_API_URL (scheme + host, no path).
API_ORIGIN=https://api.parkbor.uz
RAILWAY_DOCKERFILE_PATH=deploy/railway/crm/Dockerfile
