# redis service (Root Directory /deploy/railway/redis, volume at /data): broker / channels / state
REDIS_PASSWORD=<generated>
REDIS_POLICY=noeviction
REDIS_PERSIST=yes
REDIS_MAXMEMORY=400mb

# redis-cache service (same Dockerfile, NO volume): disposable cache and throttling counters
# REDIS_PASSWORD=<generated, different from the one above>
# REDIS_POLICY=allkeys-lru
# REDIS_PERSIST=no
# REDIS_MAXMEMORY=128mb
