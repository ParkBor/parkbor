# Production environment template. Copy to infra/.env.prod (gitignored) and fill in EVERY value.
# Used twice: `docker compose --env-file .env.prod` (interpolation) and env_file (containers).
# Use passwords/keys made of letters and digits only: a `$` would be re-interpolated by compose.
# Generate secrets, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"  (replace - and _ if you prefer)

# ---- Domains (no scheme). ADMIN_DOMAIN serves ParkBor CRM (owners and admins). Both MUST be in ALLOWED_HOSTS below.
API_DOMAIN=api.parkbor.uz
ADMIN_DOMAIN=crm.parkbor.uz
HABI_PUBLIC_URL=https://parkbor.uz
TLS_DIR=/opt/parkbor/certs
ACME_WEBROOT=/var/www/acme

# ---- Images (CI/registry tag; the default builds locally)
HABI_BACKEND_IMAGE=parkbor-backend:local
HABI_NGINX_IMAGE=parkbor-nginx:local

# ---- Django
DJANGO_SETTINGS_MODULE=config.settings.prod
SECRET_KEY=replace-me
JWT_SIGNING_KEY=replace-me
QR_SIGNING_KEY=replace-me-at-least-50-characters-long-0123456789abcdefghij
ALLOWED_HOSTS=api.parkbor.uz,crm.parkbor.uz
CORS_ALLOWED_ORIGINS=https://crm.parkbor.uz
NUM_PROXIES=1
WEB_CONCURRENCY=3

# ---- PostgreSQL (postgis scheme is mandatory)
POSTGRES_DB=habi
POSTGRES_USER=habi
POSTGRES_PASSWORD=replace-me
DATABASE_URL=postgis://habi:replace-me@db:5432/habi
# PG_MAX_CONNECTIONS=200
# PG_SHARED_BUFFERS=512MB
# PG_EFFECTIVE_CACHE_SIZE=1536MB

# ---- Redis: broker/channels/state on the noeviction server, cache on its own allkeys-lru server
REDIS_PASSWORD=replace-me
REDIS_URL=redis://:replace-me@redis:6379/0
CHANNEL_REDIS_URL=redis://:replace-me@redis:6379/1
STATE_REDIS_URL=redis://:replace-me@redis:6379/3
CACHE_REDIS_PASSWORD=replace-me-too
CACHE_REDIS_URL=redis://:replace-me-too@redis-cache:6379/0
# REDIS_MAXMEMORY=512mb
# CACHE_REDIS_MAXMEMORY=256mb

# ---- Routing
OSRM_URL=http://osrm:5000

# ---- Telegram
TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_BOT_USERNAME=replace-me
TELEGRAM_WEBHOOK_SECRET=replace-me

# ---- Payments (all mandatory in production; PAYMENTS_SANDBOX must stay false)
PAYME_MERCHANT_ID=replace-me
PAYME_KEY=replace-me
CLICK_SERVICE_ID=replace-me
CLICK_MERCHANT_ID=replace-me
CLICK_MERCHANT_USER_ID=replace-me
CLICK_SECRET_KEY=replace-me
PAYMENTS_SANDBOX=false
PAYMENTS_PAYME_IPS=185.234.113.1,185.234.113.2,185.234.113.3,185.234.113.4,185.234.113.5,185.234.113.6,185.234.113.7,185.234.113.8,185.234.113.9,185.234.113.10,185.234.113.11,185.234.113.12,185.234.113.13,185.234.113.14,185.234.113.15
PAYMENTS_CLICK_IPS=
PAYMENTS_RETURN_URL=
PAYMENTS_DEFAULT_PROVIDER=payme

# ---- Push
EXPO_ACCESS_TOKEN=

# ---- Sentry (leave SENTRY_DSN empty to disable). Release = the deployed image tag / git SHA.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0

# ---- Admin SPA build-time values (public, end up in the JS bundle)
# ADMIN_VITE_API_URL=/api/v1
# ADMIN_VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
