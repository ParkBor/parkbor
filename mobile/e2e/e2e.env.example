# Copy to mobile/e2e/.env.e2e (git-ignored by the repo's `.env.*` rule) and fill in.
# Read by scripts/run_local.sh and turned into `maestro test -e KEY=VALUE` arguments.
# Nothing here is a production secret: point everything at a LOCAL or staging stack only.

# Shared secret between the flows and helpers/e2e_hook_server.py (HABI_E2E_HOOK_KEY on the server side).
E2E_HOOK_KEY=change-me-16+-random-chars
E2E_HOOK_URL=http://127.0.0.1:8765

# Lot names printed by loadtest_seed.py --tag <tag>: LT-payments-<tag>, LT-ws0-<tag>, LT-gate-<tag>
E2E_PAY_LOT_NAME=LT-payments-e2e
E2E_WS_LOT_NAME=LT-ws0-e2e
E2E_GATE_LOT_NAME=LT-gate-e2e

# Seed gate booking used by flow 08 (each seed booking can be checked in once: use a fresh index per run).
E2E_SCAN_INDEX=0

# Dev client only (README "Android emulator"): true + Metro URL as seen FROM the device.
E2E_DEV_CLIENT=false
E2E_METRO_URL=http://10.0.2.2:8081
