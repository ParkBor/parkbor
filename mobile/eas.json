{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:8000/api/v1",
        "EXPO_PUBLIC_WS_URL": "ws://localhost:8000/ws",
        "EXPO_PUBLIC_TELEGRAM_BOT": "parkborbot",
        "EXPO_PUBLIC_EAS_PROJECT_ID": "00dc4fa1-69ea-4b36-901f-e57db4036201",
        "EXPO_PUBLIC_PAYMENT_SANDBOX": "true"
      },
      "environment": "development"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api-production-431f.up.railway.app/api/v1",
        "EXPO_PUBLIC_WS_URL": "wss://api-production-431f.up.railway.app/ws",
        "EXPO_PUBLIC_TELEGRAM_BOT": "parkborbot",
        "EXPO_PUBLIC_EAS_PROJECT_ID": "00dc4fa1-69ea-4b36-901f-e57db4036201",
        "EXPO_PUBLIC_PAYMENT_SANDBOX": "true"
      },
      "environment": "preview"
    },
    "e2e": {
      "developmentClient": false,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:8000/api/v1",
        "EXPO_PUBLIC_WS_URL": "ws://localhost:8000/ws",
        "EXPO_PUBLIC_TELEGRAM_BOT": "parkborbot",
        "EXPO_PUBLIC_EAS_PROJECT_ID": "00dc4fa1-69ea-4b36-901f-e57db4036201",
        "EXPO_PUBLIC_PAYMENT_SANDBOX": "true"
      },
      "environment": "development"
    },
    "e2e-ios-simulator": {
      "developmentClient": false,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:8000/api/v1",
        "EXPO_PUBLIC_WS_URL": "ws://localhost:8000/ws",
        "EXPO_PUBLIC_TELEGRAM_BOT": "parkborbot",
        "EXPO_PUBLIC_EAS_PROJECT_ID": "00dc4fa1-69ea-4b36-901f-e57db4036201",
        "EXPO_PUBLIC_PAYMENT_SANDBOX": "true"
      },
      "environment": "development"
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.parkbor.uz/api/v1",
        "EXPO_PUBLIC_WS_URL": "wss://api.parkbor.uz/ws",
        "EXPO_PUBLIC_TELEGRAM_BOT": "parkborbot",
        "EXPO_PUBLIC_EAS_PROJECT_ID": "00dc4fa1-69ea-4b36-901f-e57db4036201",
        "EXPO_PUBLIC_PAYMENT_SANDBOX": "false"
      },
      "environment": "production",
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      },
      "ios": {}
    }
  }
}
