{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:8000/api/v1",
        "EXPO_PUBLIC_WS_URL": "ws://localhost:8000/ws",
        "EXPO_PUBLIC_TELEGRAM_BOT": "habi_dev_bot",
        "EXPO_PUBLIC_PAYMENT_SANDBOX": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://staging-api.habi.uz/api/v1",
        "EXPO_PUBLIC_WS_URL": "wss://staging-api.habi.uz/ws",
        "EXPO_PUBLIC_TELEGRAM_BOT": "habi_staging_bot",
        "EXPO_PUBLIC_PAYMENT_SANDBOX": "true"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.habi.uz/api/v1",
        "EXPO_PUBLIC_WS_URL": "wss://api.habi.uz/ws",
        "EXPO_PUBLIC_TELEGRAM_BOT": "habi_bot"
      }
    }
  },
  "submit": { "production": {} }
}
